{
  "$defs": {
    "BundleSourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version",
        "content_hash"
      ],
      "title": "BundleSourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Id",
      "type": "string"
    },
    "language": {
      "enum": [
        "en",
        "ne",
        "tam"
      ],
      "title": "Language",
      "type": "string"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "payload_bytes": {
      "maximum": 1048576,
      "minimum": 1,
      "title": "Payload Bytes",
      "type": "integer"
    },
    "catalog_epoch": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Catalog Epoch",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/BundleSourceRef"
      },
      "title": "Sources",
      "type": "array"
    },
    "algorithm": {
      "const": "Ed25519",
      "default": "Ed25519",
      "title": "Algorithm",
      "type": "string"
    },
    "key_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Key Id",
      "type": "string"
    },
    "signature": {
      "maxLength": 88,
      "minLength": 88,
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "id",
    "language",
    "policy_version",
    "created_at",
    "valid_until",
    "payload_sha256",
    "payload_bytes",
    "catalog_epoch",
    "sources",
    "key_id",
    "signature"
  ],
  "title": "BundleManifest",
  "type": "object"
}
