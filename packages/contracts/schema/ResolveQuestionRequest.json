{
  "$defs": {
    "QuestionCandidate": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version",
        "section_id",
        "content_hash"
      ],
      "title": "QuestionCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "question": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "language": {
      "enum": [
        "en",
        "ne",
        "tam"
      ],
      "title": "Language",
      "type": "string"
    },
    "expected_snapshot": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Snapshot",
      "type": "string"
    },
    "selected": {
      "$ref": "#/$defs/QuestionCandidate"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 10,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "question",
    "language",
    "expected_snapshot",
    "selected",
    "reason"
  ],
  "title": "ResolveQuestionRequest",
  "type": "object"
}
