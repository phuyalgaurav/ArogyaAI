{
  "$defs": {
    "ArogyaResponse": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "answered",
            "needs_clarification",
            "needs_professional_review",
            "urgent",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "language": {
          "enum": [
            "en",
            "ne",
            "tam"
          ],
          "title": "Language",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "safety": {
          "$ref": "#/$defs/Safety"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "request_id",
        "status",
        "language",
        "answer",
        "evidence",
        "safety",
        "provenance"
      ],
      "title": "ArogyaResponse",
      "type": "object"
    },
    "ConversationReference": {
      "additionalProperties": false,
      "properties": {
        "attachment_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Attachment Id",
          "type": "string"
        },
        "context_revision": {
          "minimum": 0,
          "title": "Context Revision",
          "type": "integer"
        },
        "line_id": {
          "pattern": "^L[1-9][0-9]?$",
          "title": "Line Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 500,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "attachment_id",
        "context_revision",
        "line_id",
        "quote"
      ],
      "title": "ConversationReference",
      "type": "object"
    },
    "DocumentDefinition": {
      "additionalProperties": false,
      "properties": {
        "term": {
          "title": "Term",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "term",
        "meaning",
        "source_url"
      ],
      "title": "DocumentDefinition",
      "type": "object"
    },
    "DocumentExplainResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "no_match",
            "professional_review",
            "urgent"
          ],
          "title": "Status",
          "type": "string"
        },
        "notice": {
          "title": "Notice",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/DocumentItem"
          },
          "title": "Items",
          "type": "array"
        },
        "answer_line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Answer Line Ids",
          "type": "array"
        },
        "document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "speech_text_ne": {
          "maxLength": 300,
          "title": "Speech Text Ne",
          "type": "string"
        },
        "question_method": {
          "default": "none",
          "enum": [
            "none",
            "literal_document_match",
            "model_selection"
          ],
          "title": "Question Method",
          "type": "string"
        },
        "retrieval": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentRetrieval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "notice",
        "items",
        "answer_line_ids",
        "document_sha256",
        "speech_text_ne"
      ],
      "title": "DocumentExplainResult",
      "type": "object"
    },
    "DocumentItem": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "kind": {
          "enum": [
            "medicine",
            "instruction",
            "finding",
            "follow_up",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "definitions": {
          "items": {
            "$ref": "#/$defs/DocumentDefinition"
          },
          "title": "Definitions",
          "type": "array"
        },
        "check_with_professional": {
          "title": "Check With Professional",
          "type": "boolean"
        },
        "speech_text_ne": {
          "maxLength": 300,
          "title": "Speech Text Ne",
          "type": "string"
        }
      },
      "required": [
        "line_id",
        "quote",
        "kind",
        "meaning",
        "definitions",
        "check_with_professional",
        "speech_text_ne"
      ],
      "title": "DocumentItem",
      "type": "object"
    },
    "DocumentRetrieval": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "bm25",
            "full_document"
          ],
          "title": "Method",
          "type": "string"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "title": "Line Ids",
          "type": "array"
        },
        "total_lines": {
          "maximum": 40,
          "minimum": 1,
          "title": "Total Lines",
          "type": "integer"
        },
        "context_reused": {
          "title": "Context Reused",
          "type": "boolean"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "method",
        "line_ids",
        "total_lines",
        "context_reused",
        "truncated"
      ],
      "title": "DocumentRetrieval",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        }
      },
      "required": [
        "source_id",
        "version"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "local",
            "server",
            "static"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "knowledge_version": {
          "title": "Knowledge Version",
          "type": "string"
        },
        "translator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translator"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "router": {
          "default": "rules",
          "title": "Router",
          "type": "string"
        },
        "router_intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Router Intent"
        },
        "router_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Router Revision"
        },
        "routing_disagreement": {
          "default": false,
          "title": "Routing Disagreement",
          "type": "boolean"
        },
        "policy_version": {
          "default": "education-extractive-2",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "model",
        "knowledge_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Safety": {
      "additionalProperties": false,
      "properties": {
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "abstained": {
          "title": "Abstained",
          "type": "boolean"
        }
      },
      "required": [
        "rule_ids",
        "abstained"
      ],
      "title": "Safety",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Id",
      "type": "string"
    },
    "message": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "answer": {
      "maxLength": 30000,
      "title": "Answer",
      "type": "string"
    },
    "language": {
      "enum": [
        "en",
        "ne"
      ],
      "title": "Language",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "context_revision": {
      "minimum": 0,
      "title": "Context Revision",
      "type": "integer"
    },
    "status": {
      "maxLength": 60,
      "title": "Status",
      "type": "string"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/ConversationReference"
      },
      "maxItems": 40,
      "title": "References",
      "type": "array"
    },
    "document": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentExplainResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "health": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArogyaResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "resolved_question": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Question"
    },
    "restored_from_client": {
      "default": false,
      "title": "Restored From Client",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "message",
    "answer",
    "language",
    "timestamp",
    "context_revision",
    "status",
    "request_fingerprint"
  ],
  "title": "ConversationTurn",
  "type": "object"
}
