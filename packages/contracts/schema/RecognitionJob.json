{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Id",
      "type": "string"
    },
    "conversation_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Conversation Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "processing",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "stage": {
      "enum": [
        "recognizing",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "Stage",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "attachment_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attachment Id"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "conversation_id",
    "request_id",
    "status",
    "stage",
    "created_at"
  ],
  "title": "RecognitionJob",
  "type": "object"
}
