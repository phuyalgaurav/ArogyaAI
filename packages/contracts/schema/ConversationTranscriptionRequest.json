{
  "$defs": {
    "TranscriptionRequest": {
      "additionalProperties": false,
      "properties": {
        "audio_base64": {
          "maxLength": 900000,
          "minLength": 44,
          "title": "Audio Base64",
          "type": "string"
        },
        "language": {
          "const": "ne",
          "default": "ne",
          "title": "Language",
          "type": "string"
        },
        "consent_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Consent Id",
          "type": "string"
        }
      },
      "required": [
        "audio_base64",
        "consent_id"
      ],
      "title": "TranscriptionRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "expected_context_revision": {
      "minimum": 0,
      "title": "Expected Context Revision",
      "type": "integer"
    },
    "audio": {
      "$ref": "#/$defs/TranscriptionRequest"
    }
  },
  "required": [
    "request_id",
    "expected_context_revision",
    "audio"
  ],
  "title": "ConversationTranscriptionRequest",
  "type": "object"
}
